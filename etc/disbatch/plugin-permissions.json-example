# This is used by bin/disbatch-create-users to give the proper permissions to the plugin.
# Format is { collection_name: array_of_actions, ... }
# See https://docs.mongodb.org/manual/reference/built-in-roles/ for built-in roles.

# Permissions are only required when using go-task-runner with "mongo" or with "handoff" (but not when "handoff" is calling a perl module).
# A handoff plugin will need permissions for "find" and "update" on the "tasks" collection, and for GridFS (if stdout and stderr can be large) on the "tasks.files" and "tasks.chunks" collections.
# A mongo plugin will need permissions for "find" on the "tasks" collection, "insert" on the "results" collection, and for GridFS (if stdout and stderr can be large) on the "tasks.files" and "tasks.chunks" collections.
# For GridFS, "insert" is all that is needed once the first file has been stored, but uploading the first file to an empty bucket also needs "find", "listIndexes", and "createIndex".
# Also note that Disbatch::Plugin::Demo must be able to do "insert" on the 'reports' collection, and I generally give a database-wide find permission.

# My plugins typically need the following permissions:
{
#    "": [ "find" ],		# allow reading of all collections in the database
#    "nodes": [ "update" ],	# used to set maxthreads to 0 in case of serious error
#    "changelog": [ "insert" ],	# used after setting maxthreads to 0 in case of serious error
#    "users": [ "insert", "update", "createIndex" ],
#    "reports": [ "insert" ],
#    "complete": [ "insert", "update", "createIndex" ],
#    "contact_maps": [ "insert", "update", "createIndex" ],
#    "status": [ "insert", "update", "createIndex" ],
#    "yams": [ "insert", "update", "createIndex" ],
#    "tasks.chunks": [ "find", "insert", "listIndexes", "createIndex" ],	# handoff, mongo
#    "tasks.files": [ "find", "insert", "listIndexes", "createIndex" ],	# handoff, mongo
#    "tasks": [ "find", "update" ],	# handoff
#    "tasks": [ "find" ],		# mongo
#    "results": [ "insert" ],		# mongo
}

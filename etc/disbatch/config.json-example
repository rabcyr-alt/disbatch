{
    # Mandatory:
    "mongohost": "mongodb://127.0.0.1:27017",
    #"mongohost": "mongodb://dev.ashley.lan:27017/?tlsCAFile=/etc/ssl/mongodb/dev.ashley.lan.crt",	# TLS format
    "database": "disbatch_test",
    # Only needed if using MongoDB authentication:
    "auth": {
        "disbatchd": "qwerty1",
        "disbatch_web": "qwerty2",
        "task_runner": "qwerty3",
        "queuebalance": "qwerty4",
        "plugin": "qwerty5",
    },
    # Only needed if using TLS on the web server:
    "tls": {
        "SSL_ca_file": "/etc/ssl/certs/ca-bundle.crt",     # tls is enabled on the server
        #"verify_hostname": 0,                             # tls is enabled on the server, but without a valid cert
    },
    # Can only load a plugin listed here
    "plugins": {					# defaults to {}, breaking change in 4.4
        "Disbatch::Plugin::Demo": 1,	# `1` sets args.IsModule in `go-task-runner`, will run as `{"type": "handoff"}` but call `config.plugin_runner` with `--handoff`
        "Disbatch::Plugin::Test": 1,
        # for `go-task-runner`: perl and go test task programs. must be full path. change `/path/to/disbatch/` to where you have the disbatch source.
        "/path/to/disbatch/t/task-default.pl": {},
        "/path/to/disbatch/t/task-handoff.pl": {"type": "handoff"},
        "/path/to/disbatch/t/task-mongo.pl": {"type": "mongo"},
        "/path/to/disbatch/t/task-nomongo.pl": {"type": "nomongo"},
        #"/path/to/disbatch/t/task-default": {},
        #"/path/to/disbatch/t/task-handoff": {"type": "handoff"},
        #"/path/to/disbatch/t/task-mongo": {"type": "mongo"},
        "/path/to/disbatch/t/task-nomongo": {"type": "nomongo"},
    },

    "monitoring": true,					# new in 4.2
    "balance": {					# new in 4.2
        "log": true,
        "verbose": false,
        "pretend": false,
        "enabled": false,
    },
    "web_extensions": {					# new in 4.2
    },
    "process_queues_interval": 100,			# new in 4.4. controls sleep in ms between calls to `process_queues()`. default null. it should be significantly lower than `live_window_ms`
    "dashboard": {					# new in 4.4. optional web UI tunables
        "refresh_ms": 30000,				# auto-refresh interval in ms (default 30000)
        "live_window_ms": 15000,			# node-liveness window in ms (default 15000)
    },
    #"pre_hook": {
    #    "name": "Disbatch::Plugin::Prehook",		# used by lib/Disbatch.pm to load the appropriate code. required by `disbatchd`.
    #    "fatal": false,				# default is false. if true, and `disbatchd` will die if it cannot load the hook or the hook throws an error. otherwise the error is logged but ignored.
    #    # any other options you want the hook to have
    #}

    # you can use only one of these (both are optional):
    #"activequeues": [ "565b34420cef2c52d6000000" ],	# defaults to []
    #"ignorequeues": [ "565e75f03fb6ecd1c8504499" ],	# defaults to []

    "node_increase": null,	# defaults to null (no limit). per call to process_queues(), each node will only pick up this many tasks. value must be null or integer > 0.
    "queue_increase": null,	# defaults to null (no limit). per call to process_queues(), each queue will only pick up this many tasks. value must be null or integer > 0 and <= node_increase if defined.

    # Everthing below here is optional, and is set up for development, not production
    "task_runner": "./go/go-task-runner",			# defaults to "/usr/bin/go-task-runner", or "/usr/bin/task_runner" if "/usr/bin/go-task-runner" not installed
    "plugin_runner": "/root/git/disbatch/bin/task_runner",	# defaults to "/usr/bin/task_runner". have go version call perl version in handoff mode for perl module plugins. full path required!
    "temp_dir": "/tmp/disbatch",				# for go task runner task and response files. defaults to "/tmp/disbatch"
    "temp_dir_mode": "0755",					# permissions for temp_dir. defaults to "0755"
    "web_root": "etc/disbatch/htdocs/",			# defaults to "/etc/disbatch/htdocs/"
    "views_dir": "etc/disbatch/views/",			# defaults to "/etc/disbatch/views/"

    # defaults to "DEBUG" for level, and "/var/log/disbatchd.log" for the filename
    "log4perl": {
        "level": "TRACE",
        "appenders": {
            "filelog": {
                "type": "Log::Log4perl::Appender::File",
                "layout": "[%p] %d %F{1} %L %C %c> %m %n",
                "args": { "filename": "disbatchd.log" },
            },
            "screenlog": {
                "type": "Log::Log4perl::Appender::ScreenColoredLevels",
                "layout": "[%p] %d %F{1} %L %C %c> %m %n",
                "args": { "color": { "WARN": "cyan" } },	# WARN is "blue" by default, which is very hard to read in a black terminal
            }
        }
    },
}

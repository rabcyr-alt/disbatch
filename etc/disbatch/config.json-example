{
    # Mandatory:
    "mongohost": "mongodb://127.0.0.1:27017",
    "database": "disbatch_test",
    # Only needed if using SSL with MongoDB:
    "attributes": {
        "ssl": {
            "SSL_ca_file": "/etc/ssl/certs/ca-bundle.crt",	# ssl is enabled on the server
            #"SSL_verify_mode": 0,				# ssl is enabled on the server, but without a valid cert
        },
    },
    # Only needed if using MongoDB authentication:
    "auth": {
        "disbatchd": "qwerty1",
        "disbatch_web": "qwerty2",
        "task_runner": "qwerty3",
        "queuebalance": "qwerty4",
        "plugin": "qwerty5",
    },
    # Can only load a plugin listed here
    "plugins": [					# defaults to []
        "Disbatch::Plugin::Demo",
    ],

    "monitoring": true,					# new in 4.2
    "balance": {					# new in 4.2
        "log": true,
        "verbose": false,
        "pretend": false,
        "enabled": false,
    },
    "web_extensions": {					# new in 4.2
    },
    "dashboard": {					# optional; controls the web dashboard's auto-refresh and node-liveness display
        "refresh_ms": 30000,				# how often the dashboard reloads queues/nodes, in ms. defaults to 30000 (30 seconds).
        "live_window_ms": 15000,			# a node quiet longer than this is shown as "non-running", in ms. defaults to 15000 (15 seconds).
    },
    #"pre_hook": {
    #    "name": "Disbatch::Plugin::Prehook",		# used by lib/Disbatch.pm to load the appropriate code. required by `disbatchd`.
    #    "fatal": false,				# default is false. if true, and `disbatchd` will die if it cannot load the hook or the hook throws an error. otherwise the error is logged but ignored.
    #    # any other options you want the hook to have
    #}

    # you can use only one of these (both are optional):
    #"activequeues": [ "565b34420cef2c52d6000000" ],	# defaults to []
    #"ignorequeues": [ "565e75f03fb6ecd1c8504499" ],	# defaults to []

    "node_increase": null,	# defaults to null (no limit). per call to process_queues(), each node will only pick up this many tasks. value must be null or integer > 0.
    "queue_increase": null,	# defaults to null (no limit). per call to process_queues(), each queue will only pick up this many tasks. value must be null or integer > 0 and <= node_increase if defined.

    # Everthing below here is optional, and is set up for development, not production
    "task_runner": "./bin/task_runner",			# defaults to "/usr/bin/task_runner"
    #"gfs": false,					# defaults to "auto"
    "web_root": "etc/disbatch/htdocs/",			# defaults to "/etc/disbatch/htdocs/"

    # defaults to "DEBUG" for level, and "/var/log/disbatchd.log" for the filename
    "log4perl": {
        "level": "TRACE",
        "appenders": {
            "filelog": {
                "type": "Log::Log4perl::Appender::File",
                "layout": "[%p] %d %F{1} %L %C %c> %m %n",
                "args": { "filename": "disbatchd.log" },
            },
            "screenlog": {
                "type": "Log::Log4perl::Appender::ScreenColoredLevels",
                "layout": "[%p] %d %F{1} %L %C %c> %m %n",
                "args": { "color": { "WARN": "cyan" } },	# WARN is "blue" by default, which is very hard to read in a black terminal
            }
        }
    },
}

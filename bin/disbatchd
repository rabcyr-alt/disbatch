#!/usr/bin/env perl

use 5.12.0;
use warnings;

use Data::Dumper;
use Disbatch;
use Getopt::Long;
use Time::HiRes qw/ clock_gettime CLOCK_MONOTONIC usleep /;
use Try::Tiny::Retry;
#use Safe::Isa;

$SIG{HUP}  = sub { exit 129 };	# 1
$SIG{INT}  = sub { exit 130 };	# 2	ctrl-c
$SIG{QUIT} = sub { exit 131 };	# 3	ctrl-\
#$SIG{PIPE} = 'IGNORE';		# 13
$SIG{TERM} = sub { exit 143 };	# 15	kill
$SIG{CHLD} = 'IGNORE';		# 20	Zombies are bad, m'kay?
# NOTE: signal(7) says SIGCHLD is 17 on x86/ARM/most others, but 20 on Alpha/SPARC, and that on x86 20 is SIGTSTP (ctrl-z)

my $config_file = '/etc/disbatch/config.json';

GetOptions('config=s' => \$config_file);

my $disbatch = Disbatch->new(class => 'Disbatch', config_file => $config_file);
$disbatch->load_config;
$disbatch->save_strict_config;
my $logger = $disbatch->logger('DEN');
$logger->info('Starting Disbatch Execution Node');

$disbatch->ensure_indexes;
$disbatch->validate_plugins;
$disbatch->validate_hooks;

my $interval = $disbatch->{config}{process_queues_interval};	# set to `100` to call `process_queues` every 0.1 seconds (100 ms)
# NOTE: `config.dashboard.live_window_ms` default is 15000 (15 seconds), so if `config.process_queues_interval` approaches this the node will be reported as dead unless also changed

if (defined $interval) {
    $logger->logdie("config.process_queues_interval must be a positive integer (in milliseconds") unless $interval =~ /^[1-9]\d*$/;
    do {
        $disbatch->pre_hook;
        $disbatch->orphaned_tasks;
        my $until = clock_gettime(CLOCK_MONOTONIC) + 1;		# 1 second from now
        do {
            $disbatch->process_queues;
            usleep $interval * 1000;
        } while clock_gettime(CLOCK_MONOTONIC) < $until;
        $disbatch->update_node_status;
    } while 1;
} else {
    # original way, config.process_queues_interval not defined
    do {
        $disbatch->pre_hook;
        $disbatch->orphaned_tasks;
        $disbatch->process_queues;
        $disbatch->update_node_status;
    } while sleep 1;
}

END {
    $logger->info("Exit code $?");
    if ($disbatch->{claimed_task}) {
        my $unclaimed = $disbatch->unclaim_task($disbatch->{claimed_task}{_id});
        if (defined $unclaimed) {
            $logger->warn("Unclaimed task $unclaimed->{_id}");
        } else {
            $logger->error("Task $unclaimed->{_id} not unclaimed!");
        }
    }
}

__END__

=encoding utf8

=head1 NAME

disbatchd - Disbatch Execution Node (DEN)

=head1 DESCRIPTION

This is the simple master process which handles the needed steps to process queues and start tasks, and then sleeps for 1 second.

It is safe to restart this process while tasks are running, without interrupting those tasks.

=head1 SYNOPSIS

  disbatchd --config /etc/disbatch/config.json

=head1 ARGUMENTS

=over 2

=item --config <string>

Path to the JSON Disbatch config file. Default is C</etc/disbatch/config.json>.

=back


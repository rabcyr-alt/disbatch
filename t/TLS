  tls:
    mode: requireTLS
    certificateKeyFile: /etc/ssl/mongodb/dev.ashley.lan.pem
    CAFile: /etc/ssl/mongodb/dev.ashley.lan.crt
    allowConnectionsWithoutCertificates: true

# run this
openssl req -x509 -nodes -sha256 -days 1825 -newkey rsa:4096 -keyout rootCA.key -out rootCA.crt -subj="/CN=ca.ashley.lan"
openssl req -newkey rsa:4096 -keyout server.key -nodes -out domain.csr -subj "/CN=dev.ashley.lan"
# ignore this warning: "No -copy_extensions given; ignoring any extensions in the request"
openssl req -x509 -nodes -CA rootCA.crt -CAkey rootCA.key -in domain.csr -out dev.ashley.lan.crt -days 3560 \
 -subj '/CN=dev.ashley.lan' -extensions san -config <( \
   echo '[req]'; \
   echo 'distinguished_name=req'; \
   echo '[san]'; \
   echo 'subjectAltName=DNS:dev.ashley.lan,DNS:localhost')
cat rootCA.key rootCA.crt >rootCAcombined.pem
#cat server.key dev.ashley.lan.crt >serverCert.pem
cat server.key dev.ashley.lan.crt >dev.ashley.lan.pem
sudo cp dev.ashley.lan.crt dev.ashley.lan.pem /etc/ssl/mongodb/
sudo chown mongod:mongod /etc/ssl/mongodb/dev.ashley.lan.pem
systemctl restart mongod
systemctl status mongod

# connect
mongosh --u root --p kjfiwey76r3gjm --authenticationDatabase admin mongodb://dev.ashley.lan:27017/disbatch_test --tls --tlsCAFile /etc/ssl/mongodb/dev.ashley.lan.crt

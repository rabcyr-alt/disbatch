# test certs generated by the following (from https://www.mongodb.com/docs/manual/tutorial/develop-mongodb-locally-with-tls/)
openssl req -x509 -nodes -sha256 -days 1825 -newkey rsa:4096 -keyout rootCA.key -out rootCA.crt -subj="/CN=ca.mydevelopment.net"
openssl req -newkey rsa:4096 -keyout server.key -nodes -out domain.csr -subj "/CN=server.mydevelopment.net"
# ignore this warning: "No -copy_extensions given; ignoring any extensions in the request"
openssl req -x509 -nodes -CA rootCA.crt -CAkey rootCA.key -in domain.csr -out mdbinstance.mydevelopment.net.crt -days 3560 -nodes \
 -subj '/CN=<mdbinstance_mydevelopment_net>' -extensions san -config <( \
   echo '[req]'; \
   echo 'distinguished_name=req'; \
   echo '[san]'; \
   echo 'subjectAltName=DNS:localhost,DNS:mdbinstance.mydevelopment.net')
cat rootCA.key rootCA.crt >rootCAcombined.pem
cat server.key mdbinstance.mydevelopment.net.crt >serverCert.pem

# start mongo:
mongod --logpath mongo.log --dbpath tmp/ --port 54321 --fork --tlsMode requireTLS --tlsCertificateKeyFile tls/serverCert.pem --tlsCAFile tls/rootCAcombined.pem --auth

# connect to mongo via mongosh:
mongosh -u root -p kjfiwey76r3gjm --authenticationDatabase admin localhost:54321/disbatch_test6638024915 --tls --tlsCAFile tls/rootCA.crt --tlsCertificateKeyFile tls/serverCert.pem

